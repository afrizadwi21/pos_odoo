<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_custom_order_list" model="ir.ui.view">
        <field name="name">pos.custom.order.list</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <list string="Order Penjualan Kasir" decoration-success="state == 'paid'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="order_date"/>
                <field name="partner_id"/>
                <field name="cashier_id"/>
                <field name="payment_method"/>
                <field name="total_amount" sum="Total Keseluruhan"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>
    <record id="view_pos_custom_order_form" model="ir.ui.view">
        <field name="name">pos.custom.order.form</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <form string="Order Penjualan Kasir">
                <header>
                    <button name="action_pay" string="Selesaikan Pembayaran" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Batalkan Transaksi" type="object" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set Kembali ke Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Transaksi"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" placeholder="Pilih atau buat pelanggan baru"/>
                            <field name="cashier_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="order_date" readonly="state != 'draft'"/>
                            <field name="payment_method" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar Barang Belanja" name="items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" placeholder="Pilih menu..."/>
                                    <field name="product_name"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Catatan" name="notes">
                            <field name="note" placeholder="Catatan tambahan transaksi..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pos_custom_order_search" model="ir.ui.view">
        <field name="name">pos.custom.order.search</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <search string="Cari Transaksi">
                <field name="name" string="No. Transaksi"/>
                <field name="partner_id" string="Pelanggan"/>
                <field name="cashier_id" string="Kasir"/>
                <separator/>
                <filter name="filter_paid" string="Lunas / Selesai" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_cancel" string="Dibatalkan" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="filter_order_date" date="order_date"/>
                <group>
                    <filter name="group_order_day" string="Hari (Day to Day)" context="{'group_by': 'order_date:day'}"/>
                    <filter name="group_order_month" string="Bulan (Month to Month)" context="{'group_by': 'order_date:month'}"/>
                    <filter name="group_order_year" string="Tahun" context="{'group_by': 'order_date:year'}"/>
                    <filter name="group_payment" string="Metode Pembayaran" context="{'group_by': 'payment_method'}"/>
                    <filter name="group_cashier" string="Kasir" context="{'group_by': 'cashier_id'}"/>
                    <filter name="group_partner" string="Pelanggan" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pos_custom_order_kanban" model="ir.ui.view">
        <field name="name">pos.custom.order.kanban</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <kanban sample="1" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="order_date"/>
                <field name="partner_id"/>
                <field name="cashier_id"/>
                <field name="payment_method"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card" class="p-3 shadow-sm border rounded">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="fs-5 text-primary">
                                <field name="name"/>
                            </strong>
                            <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-muted small mb-2">
                            <span><i class="fa fa-user me-1"/> <field name="partner_id"/></span>
                            <span><i class="fa fa-clock-o me-1"/> <field name="order_date" widget="date"/></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="badge text-bg-light border text-uppercase">
                                <field name="payment_method"/>
                            </span>
                            <span class="fs-5 fw-bold text-success">
                                Rp <field name="total_amount"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Sales Graph View (Month to Month &amp; Day to Day) -->
    <record id="view_pos_custom_order_graph" model="ir.ui.view">
        <field name="name">pos.custom.order.graph</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <graph string="Grafik Penjualan Kasir" sample="1" type="bar">
                <field name="order_date" interval="day"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Sales Pivot View -->
    <record id="view_pos_custom_order_pivot" model="ir.ui.view">
        <field name="name">pos.custom.order.pivot</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Penjualan Kasir" sample="1">
                <field name="order_date" interval="month" type="row"/>
                <field name="payment_method" type="col"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action Window for Orders -->
    <record id="action_pos_custom_order" model="ir.actions.act_window">
        <field name="name">Order Penjualan Kasir</field>
        <field name="res_model">pos.custom.order</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_pos_custom_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada transaksi penjualan kasir!
            </p>
            <p>
                Klik tombol <b>Baru</b> untuk mencatat transaksi penjualan kasir pertama Anda.
            </p>
        </field>
    </record>

    <!-- Action Window for Sales Graph -->
    <record id="action_pos_custom_order_report_graph" model="ir.actions.act_window">
        <field name="name">Grafik Penjualan</field>
        <field name="res_model">pos.custom.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_filter_paid': 1, 'search_default_group_order_day': 1}</field>
        <field name="search_view_id" ref="view_pos_custom_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data grafik penjualan!
            </p>
            <p>
                Grafik ini menampilkan tren penjualan dari hari ke hari (day to day) dan bulan ke bulan (month to month).
            </p>
        </field>
    </record>

    <!-- Action Window for Sales Pivot Analysis -->
    <record id="action_pos_custom_order_report_pivot" model="ir.actions.act_window">
        <field name="name">Analisis Penjualan</field>
        <field name="res_model">pos.custom.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_filter_paid': 1, 'search_default_group_order_month': 1}</field>
        <field name="search_view_id" ref="view_pos_custom_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data analisis penjualan!
            </p>
            <p>
                Tabel pivot memungkinkan analisis pendapatan berdasarkan bulan, hari, metode pembayaran, dan kasir.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="pos_odoo_root_menu" name="POS Odoo" web_icon="pos_odoo,static/description/icon.png" sequence="10"/>
    <menuitem id="pos_odoo_transaction_menu" name="Transaksi" parent="pos_odoo_root_menu" sequence="10"/>
    <menuitem id="pos_odoo_order_menu" name="Order Kasir" parent="pos_odoo_transaction_menu" action="action_pos_custom_order" sequence="10"/>

    <menuitem id="pos_odoo_report_menu" name="Laporan" parent="pos_odoo_root_menu" sequence="30"/>
    <menuitem id="pos_odoo_report_graph_menu" name="Grafik Penjualan" parent="pos_odoo_report_menu" action="action_pos_custom_order_report_graph" sequence="10"/>
    <menuitem id="pos_odoo_report_pivot_menu" name="Analisis Penjualan" parent="pos_odoo_report_menu" action="action_pos_custom_order_report_pivot" sequence="20"/>

</odoo>
