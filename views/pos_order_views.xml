<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_pos_custom_order_list" model="ir.ui.view">
        <field name="name">pos.custom.order.list</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <list string="Order Penjualan Kasir" decoration-success="state == 'paid'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="order_date"/>
                <field name="partner_id"/>
                <field name="cashier_id"/>
                <field name="payment_method"/>
                <field name="total_amount" sum="Total Keseluruhan"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_pos_custom_order_form" model="ir.ui.view">
        <field name="name">pos.custom.order.form</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <form string="Order Penjualan Kasir">
                <header>
                    <button name="action_pay" string="Selesaikan Pembayaran" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Batalkan Transaksi" type="object" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set Kembali ke Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Transaksi"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" placeholder="Pilih atau buat pelanggan baru"/>
                            <field name="cashier_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="order_date" readonly="state != 'draft'"/>
                            <field name="payment_method" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar Barang Belanja" name="items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" placeholder="Pilih menu..."/>
                                    <field name="product_name"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Catatan" name="notes">
                            <field name="note" placeholder="Catatan tambahan transaksi..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_pos_custom_order_search" model="ir.ui.view">
        <field name="name">pos.custom.order.search</field>
        <field name="model">pos.custom.order</field>
        <field name="arch" type="xml">
            <search string="Cari Transaksi">
                <field name="name" string="No. Transaksi"/>
                <field name="partner_id" string="Pelanggan"/>
                <field name="cashier_id" string="Kasir"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Lunas" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Dibatalkan" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <group>
                    <filter string="Kasir" name="group_cashier" context="{'group_by': 'cashier_id'}"/>
                    <filter string="Pelanggan" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_pos_custom_order" model="ir.actions.act_window">
        <field name="name">Order Penjualan Kasir</field>
        <field name="res_model">pos.custom.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_custom_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada transaksi penjualan kasir!
            </p>
            <p>
                Klik tombol <b>Baru</b> untuk mencatat transaksi penjualan kasir pertama Anda.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="pos_odoo_root_menu" name="POS Odoo" sequence="10"/>
    <menuitem id="pos_odoo_transaction_menu" name="Transaksi" parent="pos_odoo_root_menu" sequence="10"/>
    <menuitem id="pos_odoo_order_menu" name="Order Kasir" parent="pos_odoo_transaction_menu" action="action_pos_custom_order" sequence="10"/>

</odoo>
